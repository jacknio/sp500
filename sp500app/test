
import os
os.environ["HF_HUB_OFFLINE"] = "1"

from bertopic import BERTopic
from sklearn.feature_extraction.text import TfidfVectorizer
from umap import UMAP
from hdbscan import HDBSCAN

# 1. Fake earnings call snippets
docs = [
    "AI reduced our operating costs.",
    "AI lowered employee labor costs.",
    "AI helped cut operating expenses.",
    "AI automation generated cost savings.",

    "AI products increased our revenue.",
    "AI software sales grew this quarter.",
    "AI subscriptions generated new revenue.",
    "AI products boosted customer sales.",

    "AI improved employee productivity.",
    "AI coding tools increased developer productivity.",
    "AI helped employees work faster.",
    "AI increased workforce efficiency.",

    "AI infrastructure spending increased.",
    "AI data center investments are expanding.",
    "AI server capital expenditure is rising.",
    "AI GPU infrastructure requires investment."
]

# 2. Convert text into numbers locally
vectorizer = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2)
)
embeddings = vectorizer.fit_transform(docs).toarray()

# 3. Configure clustering for a tiny dataset
umap_model = UMAP(
    n_neighbors=3,
    n_components=2,
    random_state=42
)

hdbscan_model = HDBSCAN(
    min_cluster_size=2,
    min_samples=1
)

# 4. Run BERTopic without downloading a model
model = BERTopic(
    embedding_model=None,
    umap_model=umap_model,
    hdbscan_model=hdbscan_model,
    verbose=False
)

topics, _ = model.fit_transform(docs, embeddings)

# 5. Print results
print("\n=== DISCOVERED TOPICS ===")
print(model.get_topic_info()[["Topic", "Count", "Name"]])

print("\n=== SENTENCE CLASSIFICATION ===")
for topic, sentence in zip(topics, docs):
    print(f"Topic {topic}: {sentence}")

print("\nSUCCESS - OFFLINE CLUSTERING COMPLETED")
